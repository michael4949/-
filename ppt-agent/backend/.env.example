# Copy to .env and fill in. NEVER commit the real .env.
LOVART_EMAIL=your-email@example.com
LOVART_PASSWORD=your-password-here

# Browser
HEADLESS=true               # set false locally to watch the browser
LOVART_BASE_URL=https://www.lovart.ai

# Timeouts (ms)
LOVART_NAV_TIMEOUT_MS=60000
LOVART_GENERATION_TIMEOUT_MS=300000

# Storage paths
ARTIFACTS_DIR=/tmp/ppt-agent-artifacts
LOVART_STORAGE_STATE=/tmp/lovart-state.json

# CORS
ALLOW_ORIGINS=*
