      "formula": "月收益 = 每月发生次数 × 单次损失 × 折减比例",
      "cut": 0.4,
      "cutNote": "折减系数 40%。工具可提示与拦截规则明确的异常，对依赖经验判断的情形拦截率有限。",
      "cash": true,
      "fields": [
        {
          "key": "errorFreqMonthly",
          "label": "月均发生次数",
          "unit": "次/月",
          "type": "number",
          "min": 0.05,
          "max": 200,
          "presets": [
            0.33,
            1.5,
            4.3,
            11
          ],
          "hint": "这类问题一个月出现几次"
        },
        {
          "key": "errorCostPerCase",
          "label": "单次损失金额",
          "unit": "元",
          "type": "int",
          "min": 50,
          "max": 500000,
          "presets": [
            500,
            2000,
            5000,
            20000
          ],
          "hint": "出一次约损失多少钱"
        }
      ]
    },
