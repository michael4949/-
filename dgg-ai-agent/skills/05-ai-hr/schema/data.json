{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI人力官 · 人力数据包",
  "description": "一家企业的花名册（逐人，工号 + 岗位，不含姓名）、近 12 个月离职、招聘需求单与结构化简历。工号 E-编号，候选人 C-年月-流水，需求单 R-年月-流水。",
  "type": "object",
  "required": ["archetype", "sector", "company", "today", "weekStart", "overtimeMonth", "profile", "departments", "employees", "leavers", "needs", "candidates"],
  "properties": {
    "archetype": { "enum": ["make", "flow", "project", "service"] }, "sector": { "type": "string" }, "company": { "type": "string" }, "co": { "type": "string" },
    "today": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "weekStart": { "type": "string" }, "overtimeMonth": { "type": "string", "description": "考勤加班数据所属月份" },
    "profile": { "type": "object", "required": ["industry", "province", "city", "founded", "revenue12", "product"], "properties": { "province": { "type": "string", "description": "对应 cost-params.json regions 的键" }, "revenue12": { "type": "number", "description": "近 12 个月收入，与 AI CFO 账套一致" }, "product": { "type": "string" }, "lines": { "type": "string" }, "customers": { "type": "string" }, "region": { "type": "string" }, "hotAllowancePaid": { "type": "boolean" }, "hotJobsDepts": { "type": "array", "items": { "type": "string" } }, "wageIndex": { "type": "number", "description": "企业工资水平相对岗位库基准的指数，薪酬带按此换算" } } },
    "sources": { "type": "array", "items": { "type": "object", "required": ["id", "name", "mode"], "properties": { "mode": { "enum": ["direct", "import"] } } } },
    "departments": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "name", "budget"], "properties": { "budget": { "type": "integer", "description": "编制" } } } },
    "employees": { "type": "array", "minItems": 5, "items": { "type": "object", "required": ["id", "dept", "job", "family", "hireDate", "gender", "birthYear", "edu", "wage", "contract", "socialBase", "injuryInsured", "overtimeH", "annualDue", "annualUsed", "status", "dispatch", "disabled"], "properties": {
      "id": { "type": "string", "pattern": "^E-\\d{3}$" }, "job": { "type": "string", "description": "岗位库键" }, "family": { "enum": ["ops", "tech", "sales", "func"] },
      "edu": { "enum": ["secondary", "college", "bachelor", "master"] }, "wage": { "type": "number", "description": "月应发" }, "socialBase": { "type": "number" },
      "contract": { "type": "object", "required": ["type", "years", "start", "end", "probationMonths", "signed", "noncompete", "noncompeteComp"], "properties": { "type": { "enum": ["fixed", "open", "dispatch"] } } },
      "status": { "enum": ["active", "maternity"] }, "leaveEnd": { "type": ["string", "null"] }
    } } },
    "leavers": { "type": "array", "items": { "type": "object", "required": ["id", "dept", "job", "date", "reason"] } },
    "needs": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "job", "dept", "count", "dueDate", "reason"], "properties": { "id": { "type": "string", "pattern": "^R-\\d{4}-\\d{2}$" }, "status": { "enum": ["open", "published"] }, "publishedVariant": { "type": ["string", "null"] } } } },
    "candidates": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "needId", "edu", "years", "skills", "lastTenureMonths", "jobs5y", "expected", "availableDays", "distanceKm", "source"], "properties": {
      "id": { "type": "string", "pattern": "^C-\\d{4}-\\d{3}$" }, "source": { "enum": ["site", "referral", "school", "headhunter", "return"] },
      "stage": { "enum": ["new", "screened", "interview", "done", "offer", "hired", "rejected"] }, "scores": { "type": ["object", "null"], "properties": { "pro": { "type": "number" }, "coop": { "type": "number" }, "stable": { "type": "number" }, "value": { "type": "number" } } }, "interviewDate": { "type": ["string", "null"] }, "offer": { "type": ["object", "null"] }
    } } },
    "resolved": { "type": "object", "description": "已处置的合规规则：规则 id → { date, status, action }" },
    "plan": { "type": ["string", "null"], "enum": ["A", "B", "C", null] },
    "log": { "type": "array", "items": { "type": "object", "required": ["seq", "kind", "label"] } }
  }
}
