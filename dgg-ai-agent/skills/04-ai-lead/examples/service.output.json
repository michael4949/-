  "script": {
    "key": "S1|phone|first",
    "words": 294,
    "sections": [
      {
        "key": "open",
        "title": "开场",
        "text": "总经理您好，我是启元的业务，做代理记账与财税服务的。冒昧打扰两分钟：最近和几家餐饮管理公司聊下来，大家在供应端都卡在同一件事上，想跟您核对一下贵司是否也有同样情况。"
      },
      {
        "key": "pain",
        "title": "痛点",
        "text": "老板层面看的无非是每天食材报损多少心里没数，月底盘出来才心疼和门店客流靠位置和外卖平台带，自己手里没有客源这两件事会不会影响生意。我们能做的是把这两件事变成可以核的数字。"
      },
      {
        "key": "value",
        "title": "价值",
        "text": "我们能给到的是两点：每月 10 日前出报表，含税负与现金提示；政策匹配每季一次，可享项目主动提醒。"
      },
      {
        "key": "proof",
        "title": "案例",
        "text": "举个例子，K-311 · 餐饮管理公司：12 家门店账务统一，季度政策匹配拿到稳岗返还。"
      },
      {
        "key": "cta",
        "title": "行动",
        "text": "您看这样：我把样品和检测数据寄到您那边，下周三前后我再联系您，行吗？"
      }
    ],
    "objections": [
      {
        "q": "值不值得换",
        "a": "换不换看数字：交期、退货率、总成本，三个数我帮您算，不合适您不用换。"
      },
      {
        "q": "你们规模够不够",
        "a": "我们服务的客户里有比贵司大的，交付记录可以查；量大的单我们提前排产。"
      },
      {
        "q": "没时间",
        "a": "理解，我十分钟说完，您觉得没意思随时打断。"
      }
    ]
  },
