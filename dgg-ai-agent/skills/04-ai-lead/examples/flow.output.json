  "script": {
    "key": "S1|phone|first",
    "words": 275,
    "sections": [
      {
        "key": "open",
        "title": "开场",
        "text": "采购经理您好，我是恒益的业务，做日用百货与快消品的。冒昧打扰两分钟：最近和几家连锁便利店聊下来，大家在供应端都卡在同一件事上，想跟您核对一下贵司是否也有同样情况。"
      },
      {
        "key": "pain",
        "title": "痛点",
        "text": "您这个位置最怕两件事：客户问价要业务员翻价格表和库存，常常隔天才回，下游批发客户几个月不下单，没人发现也没人问。这两件事我们都碰到过，也都有对应的做法。"
      },
      {
        "key": "value",
        "title": "价值",
        "text": "我们能给到的是两点：48 小时到店，冷链到仓当日上架；按量阶梯价，月结对账单随货。"
      },
      {
        "key": "proof",
        "title": "案例",
        "text": "举个例子，K-102 · 连锁便利店总部：86 家门店统一配送两年，缺货率 1.2%。"
      },
      {
        "key": "cta",
        "title": "行动",
        "text": "您看这样：我把样品和检测数据寄到您那边，下周三前后我再联系您，行吗？"
      }
    ],
    "objections": [
      {
        "q": "价格比现在的供应商高",
        "a": "我理解。建议把交期延误和批次退货的损失一起算，多数客户算完发现总成本反而低。我可以按贵司去年的数据帮您算一遍。"
      },
      {
        "q": "现在的供应商合作很多年了",
        "a": "老供应商有老供应商的好，我们不是来替换谁的，先做第二供应商，有急单或者对方出问题时贵司多一个选择。"
      },
      {
        "q": "账期太短",
        "a": "账期可以按贵司习惯来，首批我们按 30 天，稳定合作后可以放到 60 天。"
      }
    ]
  },
