{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI流程提效 · 生产环节数据包",
  "description": "一个生产部门一周的生产环节数据：产线 / 工序 / 路线 / 标准工时取自 AI ERP 样本（erpKey），本包只放报工、12 周工时统计、时间损失、设备、排班、技能、今日批次、周指标与客户动作留下的状态。员工只出现 E-编号（id / job / overtimeH 三个键）。异常 EX-月日-流水，改善项目 IMP-年月-流水，保养 PM-年月-流水，带教 TR-年月-流水，增效账 LG-流水。",
  "type": "object",
  "required": ["archetype", "company", "dept", "today", "weekStart", "erpKey", "sources", "constraintExpected", "spareLine", "releaseLine", "shiftHours", "otCap", "buffers", "fixtures", "setupMatrix", "setupSteps", "spare", "lunchH", "employees", "skills", "empStats", "roster", "reports", "stdStats", "lossWeekly", "lossToday", "machines", "planHit", "jobsToday", "weekly", "wipHistory", "facts"],
  "properties": {
    "archetype": { "enum": ["make", "flow", "service"], "description": "词表键：制造 / 仓配 / 服务" },
    "company": { "type": "string" }, "dept": { "type": "string" },
    "today": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "weekStart": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "本周一" },
    "erpKey": { "enum": ["make", "flow", "service"], "description": "取 AI ERP 哪套样本的产线 / 工序 / 路线" },
    "sources": { "type": "array", "items": { "type": "object", "required": ["id", "name", "mode"], "properties": { "id": { "enum": ["route", "report", "machine", "roster"] }, "mode": { "enum": ["direct", "import"] }, "lastSync": { "type": "string" }, "rows": { "type": "integer" } } } },
    "constraintExpected": { "type": "string", "description": "预期约束线 id（内核按负荷与排队自行识别，此处供校验与预演）" },
    "spareLine": { "type": "string" }, "releaseLine": { "type": "string", "description": "投料 / 放行线 id" },
    "supportIds": { "type": "array", "items": { "type": "string", "pattern": "^E-\\d{3}$" } },
    "spcMachine": { "type": "string" }, "dueMachine": { "type": "string" },
    "shiftHours": { "type": "number", "minimum": 1 },
    "otCap": { "type": "object", "required": ["month", "day"], "properties": { "month": { "type": "number" }, "day": { "type": "number" } } },
    "buffers": { "type": "object", "additionalProperties": { "type": "object", "required": ["capDays"], "properties": { "capDays": { "type": "number", "minimum": 0 } } }, "description": "约束线前在制上限 = capDays × 日可用小时" },
    "fixtures": { "type": "object", "additionalProperties": { "type": "object", "required": ["fixture", "program"], "properties": { "fixture": { "type": "string" }, "program": { "type": "string" } } } },
    "setupMatrix": { "type": "object", "required": ["sameProduct", "sameFixture", "diffFixture"], "properties": { "sameProduct": { "type": "number" }, "sameFixture": { "type": "number" }, "diffFixture": { "type": "number" } }, "description": "换型分钟：同产品换批 / 同工装换程序 / 换工装" },
    "setupSteps": { "type": "array", "items": { "type": "object", "required": ["name", "min", "internal"], "properties": { "name": { "type": "string" }, "min": { "type": "number" }, "internal": { "type": "boolean" } } } },
    "firstPieceItems": { "type": "array", "items": { "type": "string" } },
    "spare": { "type": "object", "required": ["line", "capPerPerson"], "properties": { "line": { "type": "string" }, "capPerPerson": { "type": "number" }, "effTo": { "type": "number" }, "defaultSupport": { "type": "integer" } } },
    "lunchH": { "type": "number" }, "firstPieceMinPerSetup": { "type": "number" },
    "employees": { "type": "array", "items": { "type": "object", "required": ["id", "job", "overtimeH"], "additionalProperties": false, "properties": { "id": { "type": "string", "pattern": "^E-\\d{3}$" }, "job": { "type": "string" }, "overtimeH": { "type": "number" } } } },
    "skills": { "type": "array", "items": { "type": "object", "required": ["emp", "home", "levels"], "properties": { "emp": { "type": "string" }, "home": { "type": ["string", "null"] }, "levels": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 3 } } } } },
    "empStats": { "type": "array", "items": { "type": "object", "required": ["emp", "op", "n", "effMed"], "properties": { "n": { "type": "integer" }, "effMed": { "type": "number" } } } },
    "roster": { "type": "array", "items": { "type": "object", "required": ["date", "shift", "line", "emps"], "properties": { "shift": { "enum": ["A", "B"] }, "leader": { "type": ["string", "null"] }, "emps": { "type": "array", "items": { "type": "string" } }, "planned": { "type": "boolean" } } } },
    "reports": { "type": "array", "items": { "type": "object", "required": ["id", "date", "shift", "line", "op", "order", "product", "emp", "qtyGood", "qtyRework", "runMin", "setupMin", "waitMin", "startMin", "endMin", "std"], "properties": {
      "id": { "type": "string" }, "date": { "type": "string" }, "shift": { "enum": ["A", "B"] }, "line": { "type": "string" }, "machine": { "type": ["string", "null"] }, "op": { "type": "string" }, "order": { "type": "string" }, "product": { "type": "string" }, "emp": { "type": ["string", "null"] },
      "qtyGood": { "type": "number", "minimum": 0 }, "qtyRework": { "type": "number", "minimum": 0 }, "runMin": { "type": "number" }, "setupMin": { "type": "number" }, "waitMin": { "type": "number" }, "waitReason": { "type": ["string", "null"] }, "firstPieceOk": { "type": ["boolean", "null"] },
      "startMin": { "type": "number" }, "endMin": { "type": "number" }, "source": { "type": "string" }, "verified": { "type": "boolean" }, "std": { "type": "number", "description": "报工时的标准工时 h/件" } } } },
    "missingSlot": { "type": ["object", "null"], "required": ["date", "shift", "line", "order", "op", "suggestQty", "suggestRunMin"] },
    "stdStats": { "type": "array", "items": { "type": "object", "required": ["product", "op", "line", "std", "n", "median", "p25", "p75"], "properties": { "std": { "type": "number" }, "n": { "type": "integer" }, "median": { "type": "number" }, "p25": { "type": "number" }, "p75": { "type": "number" } } }, "description": "12 周单件工时统计，校准用" },
    "lossWeekly": { "type": "array", "items": { "$ref": "#/definitions/lossRow" } },
    "lossToday": { "type": "array", "items": { "$ref": "#/definitions/lossRow" }, "description": "本周逐日损失（今日按半天计）" },
    "machines": { "type": "array", "items": { "type": "object", "required": ["id", "line", "cumRunH", "pmIntervalH", "pmMinutes", "downEvents", "stops12w"], "properties": {
      "tooling": { "type": ["object", "null"], "properties": { "id": { "type": "string" }, "usedUnits": { "type": "number" }, "lifeUnits": { "type": "number" } } },
      "downEvents": { "type": "array", "items": { "type": "object", "required": ["date", "fromMin", "toMin", "reason"] } },
      "stops12w": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "type": "number" } } } } },
    "planHit": { "type": "array", "items": { "type": "object", "required": ["line", "shift", "plan", "hours"], "properties": { "hours": { "type": "array", "items": { "type": "number" } } } } },
    "jobsToday": { "type": "array", "maxItems": 9, "items": { "type": "object", "required": ["id", "order", "product", "op", "qty", "dueDay", "fixture", "program"] }, "description": "约束线今日批次（≤ 9 个，全排列枚举）" },
    "weekly": { "type": "array", "minItems": 4, "items": { "type": "object", "required": ["week", "flowDays", "effUtil", "wipDays", "fpy", "otHours", "output"], "properties": { "week": { "type": "string" } } } },
    "wipHistory": { "type": "array", "items": { "type": "object", "required": ["week", "units"] } },
    "facts": { "type": "object", "required": ["bottleneck", "overtimeOver"], "properties": { "bottleneck": { "type": "string" }, "overtimeOver": { "type": "integer" } }, "description": "与 AI决策样本对齐的事实：瓶颈名、加班超限人数" },
    "focus": { "type": ["string", "null"] }, "focusLoss": { "type": ["string", "null"] },
    "verified": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "adopted": { "type": "object", "additionalProperties": { "type": "number" } },
    "exceptions": { "type": "object", "additionalProperties": { "enum": ["open", "doing", "closed"] } },
    "releasePlan": { "type": ["object", "null"] }, "jobSeq": { "type": ["object", "null"] }, "dispatch": { "type": ["object", "null"] },
    "projects": { "type": "array", "items": { "type": "object", "required": ["id", "keys", "name", "owner", "status", "milestones"], "properties": { "id": { "type": "string", "pattern": "^IMP-\\d{4}-\\d{2}$" }, "status": { "enum": ["executing", "observing", "done"] }, "milestones": { "type": "array", "items": { "type": "object", "required": ["title", "due", "owner", "status"], "properties": { "status": { "enum": ["pending", "doing", "done"] } } } } } } },
    "ledger": { "type": "array", "items": { "type": "object", "required": ["id", "source", "action", "kind", "savedH", "isBottleneck"], "properties": { "kind": { "enum": ["setup", "wait", "rework", "down", "ot", "release", "support"] } } } },
    "maintenance": { "type": "array", "items": { "type": "object", "required": ["id", "machine", "line", "date", "minutes"] } },
    "training": { "type": "array", "items": { "type": "object", "required": ["id", "trainee", "op", "start"] } },
    "log": { "type": "array", "items": { "type": "object", "required": ["seq", "kind", "label", "at"] } }
  },
  "definitions": {
    "lossRow": { "type": "object", "required": ["line", "plannedMin", "setupMin", "downMin", "waitMin", "speedMin", "reworkMin"], "properties": {
      "week": { "type": "string" }, "date": { "type": "string" }, "line": { "type": "string" }, "plannedMin": { "type": "number" }, "setupMin": { "type": "number" }, "downMin": { "type": "number" },
      "waitMin": { "type": "object", "additionalProperties": { "type": "number" }, "description": "键为词表 waitReasons" }, "speedMin": { "type": "number" }, "reworkMin": { "type": "number" } } }
  }
}
