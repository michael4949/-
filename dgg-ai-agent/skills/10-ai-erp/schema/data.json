{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI ERP · 指挥室数据包",
  "description": "一家企业接入后的在手订单、路线、资源与日历。日期一律 YYYY-MM-DD；数量单位由业态词表决定。",
  "type": "object",
  "required": ["archetype", "company", "today", "lines", "products", "materials", "orders"],
  "properties": {
    "archetype": { "enum": ["make", "flow", "project", "service"] },
    "company": { "type": "string" },
    "today": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "horizon": { "type": "integer", "minimum": 7, "maximum": 60, "default": 21 },
    "workday": { "type": "object", "properties": { "restWeekdays": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 6 } }, "restDays": { "type": "array", "items": { "type": "string" } } } },
    "labor": { "type": "object", "properties": { "hourly": { "type": "number" }, "overtimeMul": { "type": "number" } } },
    "sources": { "type": "array", "items": { "type": "object", "required": ["id", "name", "mode"], "properties": { "mode": { "enum": ["direct", "import"] }, "lastSync": { "type": "string" }, "rows": { "type": "integer" } } } },
    "lines": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "name", "capHoursPerDay", "ops"], "properties": { "capHoursPerDay": { "type": "number", "minimum": 1 }, "crew": { "type": "integer" }, "ops": { "type": "array", "items": { "type": "string" } }, "eff": { "type": "number", "minimum": 0.1, "maximum": 1.5 } } } },
    "products": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "name", "route", "bom"], "properties": {
      "route": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["op", "line", "hoursPerUnit"], "properties": { "hoursPerUnit": { "type": "number", "minimum": 0 }, "setupHours": { "type": "number", "minimum": 0 } } } },
      "bom": { "type": "array", "items": { "type": "object", "required": ["material", "qtyPer"], "properties": { "op": { "type": "string", "description": "在哪道工序领用；缺省为首道" }, "per": { "enum": ["unit", "order"], "description": "order 表示按单计，不随数量放大" } } } } } } },
    "materials": { "type": "array", "items": { "type": "object", "required": ["id", "name", "unit", "stock", "safety", "leadDays"], "properties": {
      "onOrder": { "type": "array", "items": { "type": "object", "required": ["po", "qty", "eta"], "properties": { "expedited": { "type": "boolean" } } } },
      "moq": { "type": "number" }, "pack": { "type": "number" }, "unitCost": { "type": "number" }, "supplier": { "type": "string" }, "avgDailyUse": { "type": "number" } } } },
    "orders": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "customer", "product", "qty", "due"], "properties": {
      "priority": { "type": "integer", "minimum": 0, "maximum": 9, "description": "0 为插单置顶，1 重点，2 普通，3 备货，9 末尾" },
      "received": { "type": "string" },
      "progress": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
      "overrides": { "type": "object", "properties": { "lines": { "type": "object", "additionalProperties": { "type": "string" } } } },
      "parts": { "type": "array", "items": { "type": "object", "required": ["id", "qty"], "properties": { "lines": { "type": "object" } } } },
      "originalDue": { "type": "string" }, "handled": { "type": "boolean" },
      "actions": { "type": "array", "items": { "type": "object", "required": ["key", "label", "detail"] } } } } },
    "insertPresets": { "type": "array", "items": { "type": "object", "required": ["customer", "product", "qty", "due"] } },
    "overtime": { "type": "array", "items": { "type": "object", "required": ["line", "from", "days", "hours"] } },
    "log": { "type": "array", "items": { "type": "object", "required": ["seq", "orderId", "action", "label", "detail"] } }
  }
}
