{
  "_note": "第三屏「现状与目标」四项。每项都会改变四维得分或组合建议，取值与调整幅度在此定义。",
  "groups": [
    { "key": "sales",   "name": "获客与销售", "color": "#8A54DC", "desc": "线索、报价、成交与客户维护" },
