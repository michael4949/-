  "fields": [
    { "key": "dataState", "label": "数据现在放在哪", "required": true,
      "options": [
        { "v": "paper",     "t": "纸质单据与手工记录为主", "adj": -1,   "note": "数据需要先做电子化，起步阶段以零数据依赖的场景为主" },
        { "v": "excel",     "t": "主要在 Excel 表里",       "adj": -0.5, "note": "表格口径需要先统一，整理一次即可支撑轻量场景" },
        { "v": "system",    "t": "大部分在业务系统里",     "adj": 0,    "note": "数据条件较好，可直接进入系统内取数" },
        { "v": "scattered", "t": "在多个系统里但没打通",   "adj": -0.5, "note": "跨系统取数需要先对齐主数据，单系统内场景可先行" }
      ] },
    { "key": "objective", "label": "接下来半年最想改善", "required": true,
      "options": [
        { "v": "cost",       "t": "降成本", "keywords": ["成本", "工时", "库存", "能耗", "费用", "损耗", "采购", "呆滞"] },
        { "v": "revenue",    "t": "增收入", "keywords": ["线索", "询盘", "转化", "成单", "客户", "复购", "回款", "客单"] },
        { "v": "efficiency", "t": "提效率", "keywords": ["缩短", "提速", "响应", "周期", "自动", "重复", "整理", "效率"] },
        { "v": "compliance", "t": "控风险", "keywords": ["合规", "风险", "留痕", "审核", "台账", "证照", "追溯", "资质"] }
      ] },
    { "key": "window", "label": "希望多久看见结果", "required": true,
      "options": [
        { "v": "m3",  "t": "3 个月内", "fast": 1,    "note": "以见效快的轻量场景起步" },
        { "v": "m6",  "t": "6 个月内", "fast": 0,    "note": "按标准节奏推进" },
        { "v": "m12", "t": "12 个月内", "fast": -0.5, "note": "可以接受周期较长的系统级场景" }
      ] },
    { "key": "capacity", "label": "能投入的人", "required": true,
      "options": [
        { "v": "none", "t": "暂时没有专人",     "adj": 1,    "note": "由业务骨干兼顾，优先选当天可起步的场景" },
        { "v": "part", "t": "现有人员兼职推进", "adj": 0.5,  "note": "以单点场景起步，避免同时铺开" },
        { "v": "one",  "t": "有 1 名专职",      "adj": 0,    "note": "可按三批次节奏推进" },
        { "v": "team", "t": "有一个小团队",     "adj": -0.5, "note": "可并行推进两个场景" }
      ] }
  ],
  "painRange": { "min": 3, "max": 8, "severityDefault": 3,
