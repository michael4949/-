{
  "_note": "四维评分轴。权重默认值取 DM 定稿公式，现场可调；调整后按和为 1 归一化。",
  "formula": "总分 = 痛点强度 × 0.35 + 数据可得 × 0.30 + 见效周期 × 0.20 + (6 − 实施门槛) × 0.15",
  "items": [
    { "key": "pain",    "name": "痛点强度", "weight": 0.35, "color": "#E0635C", "invert": false,
      "desc": "这个场景解决的是否正是您勾选的痛点",
      "how": "场景的痛点标签与您勾选的痛点求交集，按您给出的严重度加权，映射到 1–5 分",
      "scale": ["未命中所选痛点", "轻微相关", "命中一项", "命中且严重度较高", "正面命中所选重点痛点"] },
    { "key": "data",    "name": "数据可得", "weight": 0.30, "color": "#1157B5", "invert": false,
      "desc": "落地这个场景所需的数据，现在拿不拿得到",
      "how": "场景的数据依赖与您现有的业务系统比对，再按数据存放现状调整；关键系统缺失时计 1 分",
      "scale": ["关键数据源缺失", "数据分散需要整理", "部分数据可得", "主要数据可得", "所需数据均已具备"] },
    { "key": "cycle",   "name": "见效周期", "weight": 0.20, "color": "#0E9F6E", "invert": false,
      "desc": "从开始做到看见结果需要多久",
      "how": "取场景预设的见效速度，再按您期望的见效窗口调整",
      "scale": ["一年以上", "半年以上", "三到六个月", "一到三个月", "一个月内可见"] },
    { "key": "barrier", "name": "实施门槛", "weight": 0.15, "color": "#C9A227", "invert": true,
      "desc": "落地要动多少流程、系统与人",
      "how": "取场景预设的实施门槛，再按您可投入的人力调整；计分时用（6 − 门槛），门槛越低得分越高",
      "scale": ["当天可起步", "一周内可起步", "需要跨部门配合", "需要改造流程或系统", "需要系统改造与外部配合"] }
  ],
  "presets": [
    { "key": "dm",      "name": "标准权重", "weights": { "pain": 0.35, "data": 0.30, "cycle": 0.20, "barrier": 0.15 }, "desc": "四维按定稿口径加权" },
    { "key": "quick",   "name": "先要见效", "weights": { "pain": 0.30, "data": 0.25, "cycle": 0.35, "barrier": 0.10 }, "desc": "把见效速度提到首位" },
    { "key": "ready",   "name": "先看条件", "weights": { "pain": 0.25, "data": 0.45, "cycle": 0.15, "barrier": 0.15 }, "desc": "优先挑数据已经具备的" },
    { "key": "painful", "name": "先解痛点", "weights": { "pain": 0.50, "data": 0.25, "cycle": 0.15, "barrier": 0.10 }, "desc": "按痛点严重度排先后" }
  ]
}
