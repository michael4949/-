# 启光研发智能体环境变量样例。复制为 .env 后填入真实值。

# 必填:Anthropic API Key(https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# 可选:模型覆写。默认 Opus 4.8 + Sonnet 4.6 是当前性价比与质量最优的组合。
# 如要测试新模型,改这里即可,无需改代码。
QIGUANG_OPUS_MODEL=claude-opus-4-8
QIGUANG_SONNET_MODEL=claude-sonnet-4-6

# 可选:命题质检失败时最多让命题执笔修订几轮。默认 3 轮。
QIGUANG_MAX_REVISION_ROUNDS=3

# 可选:成卷文件存放目录。默认 outputs/
QIGUANG_OUTPUT_DIR=outputs

# 可选:是否启用 Anthropic 端的 prompt cache(降低 90% 重复读成本)。默认开启。
QIGUANG_ENABLE_CACHE=1

# 可选:是否输出详细日志。默认开启,便于教研老师观察各 Agent 的工作过程。
QIGUANG_VERBOSE=1
